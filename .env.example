# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/job-agent-ai

# JWT (use long random strings in production)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Single WhatsApp session → jobs attach to this user (ObjectId) or first admin
DEFAULT_PIPELINE_USER_ID=

# Free tier usage limits
FREE_MAX_RESUMES=5
FREE_MAX_JOBS_PER_DAY=50
FREE_MAX_UPLOADS_PER_DAY=10
FREE_MAX_PENDING_APPROVALS=25

# Demo login — allowed when NODE_ENV=development, or set true in production
DEMO_LOGIN_ENABLED=true

# CORS (comma-separated origins in production)
CORS_ORIGINS=http://localhost:3000

# Socket
SOCKET_HEARTBEAT_MS=5000
SOCKET_DEBUG=false

# Telegram (approval + alerts)
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional per-user chat map: {"mongoUserId":"telegramChatId"}
TELEGRAM_CHAT_MAP=
